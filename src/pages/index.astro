---
import Layout from '../layouts/Layout.astro';

const facts = [
  'Кошки спят 12–16 часов в сутки.',
  'Мурлыканье кошки имеет частоту 25–150 Гц.',
  'У кошки 32 мышцы в каждом ухе.',
  'Кошки не чувствуют сладкий вкус.',
];
---

<Layout title="Cat Lab — всё о кошках">
  <h1>Добро пожаловать в Cat Lab 🐾</h1>
  <p>Простой сайт о кошках: интересные факты и популярные породы.</p>

  <h2>Факты о кошках</h2>
  <ul>
    {facts.map((fact) => (
      <li>{fact}</li>
    ))}
  </ul>
</Layout>
