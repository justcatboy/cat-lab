---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Страница не найдена — Cat Lab">
  <div class="not-found">
    <p class="cat" aria-hidden="true">
      🙀
    </p>
    <h1>404 — страница не найдена</h1>
    <p>Похоже, кот уронил эту страницу со стола.</p>
    <p>
      <a href={`${base}/`}>Вернуться на главную</a>
    </p>
  </div>
</Layout>

<style>
  .not-found {
    text-align: center;
  }
  .cat {
    font-size: 5rem;
    margin: 0;
  }
  a {
    color: #6b4f3a;
    font-weight: 600;
  }
</style>
